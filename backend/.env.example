# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
DATABASE_NAME=pocketpilot
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# AI provider: groq | gemini | none (none = built-in rule-based answers only)
AI_PROVIDER=groq
# Groq: key from https://console.groq.com/keys ; models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=20
# Gemini (only used when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=20
AI_RATE_LIMIT_PER_10_MIN=30
# Timezone used to decide what "today" is
APP_TIMEZONE=Asia/Kolkata
# Allow the in-app sample notification simulator
ENABLE_NOTIFICATION_SIMULATOR=true
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173
